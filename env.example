##################################################################
# This file is used by `docker-compose` and sets default values.
# You can override any of these in your shell, for example by
# adding export statements to your .bashrc:
#    export DDS_MYSQL_ROOT_PASS=your-value-here
##################################################################

SECRET_KEY=your-value-here
# Optional: absolute path for SQLite DB and product uploads (Docker: e.g. /data).
# Defaults to <project>/instance/ when unset.
SHOP_DATA_DIR=
# Optional: full SQLAlchemy URL. When unset, SQLite uses $SHOP_DATA_DIR/app.db
DATABASE_URL=
FLASK_DEBUG=your-value-here
GITHUB_CLIENT_ID=your-value-here
GITHUB_CLIENT_SECRET=your-value-here
GOOGLE_SHEET_ID=your-value-here
